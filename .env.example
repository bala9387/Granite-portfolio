# Sri Akshaya Granites - Environment Variables
# Configure these in your Netlify Dashboard (Site settings > Environment variables)

# Optional: Resend API Key for live email notifications from Quote & Contact forms
# If omitted, form submissions are logged cleanly without throwing errors
RESEND_API_KEY=

# Optional: Recipient email address for quotations and inquiries (default: sales@sriakshayagranites.com)
CONTACT_EMAIL=sales@sriakshayagranites.com

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://sriakshayagranites.com
